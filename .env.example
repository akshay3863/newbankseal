# =============================================================================
# Bank Seal — environment template.
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Every variable here is server-only unless prefixed NEXT_PUBLIC_.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- Database (Neon PostgreSQL) --------------------------------------------
# Pooled connection string from the Neon console. Must include `sslmode=require`.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/bankseal?sslmode=require"
# Direct (non-pooled) URL — used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/bankseal?sslmode=require"

# --- Application -----------------------------------------------------------
# Canonical origin. Used for cookie scoping, CSRF origin checks and absolute URLs.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cryptography ----------------------------------------------------------
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
# Rotating this invalidates every active session.
SESSION_SECRET="replace-me-with-openssl-rand-base64-48"
# Independent secret for CSRF token signing.
CSRF_SECRET="replace-me-with-openssl-rand-base64-48"

# --- Rate limiting ---------------------------------------------------------
# Optional Upstash Redis. When absent the app falls back to an in-process limiter
# (single-instance only — set these before running more than one server node).
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REDIS_TOKEN=""

# --- Observability ---------------------------------------------------------
LOG_LEVEL="info"

# --- Media (Cloudinary) ----------------------------------------------------
# Signed admin uploads only. Copy "API environment variable" from the Cloudinary console.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""

# --- Email (AWS SES) -------------------------------------------------------
# "console" logs mail instead of sending it — the default in development and test.
# Production must set this explicitly: "ses", or "console" for a preview that must
# never send. "ses" needs a verified sender domain (SPF, DKIM, DMARC) and SES
# production access; never point a test environment at real recipients.
EMAIL_PROVIDER="console"
EMAIL_FROM="Bank Seal <no-reply@example.com>"
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_CONFIGURATION_SET=""
# SNS topic that delivers SES bounce/complaint events. The webhook rejects any other.
SES_SNS_TOPIC_ARN=""

# --- Scheduled jobs --------------------------------------------------------
# Bearer secret Vercel Cron sends to /api/internal/jobs/*. 32+ characters.
# Generate with: openssl rand -base64 48. Unset means every job call is rejected.
CRON_SECRET=""

# --- SEO and analytics -----------------------------------------------------
# Search Console HTML-tag verification token (the content="…" value only).
GOOGLE_SITE_VERIFICATION=""
# GA4 measurement id, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
